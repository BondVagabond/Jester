    # filters and relevance
    def _tokset(self, *texts):
        s = set()
        for t in texts:
            if not t: continue
            t = t.lower()
            s.update(re.split(r"[\\W_]+", t))
        return {x for x in s if x}

    def relevance_score(self, *, url: str, filename: str, link_text: str) -> int:
        toks = self._tokset(url, filename, link_text)
        score = 0
        for term in self.include_terms:
            if term in toks: score += 2
        for term in self.exclude_terms:
            if term in toks: score -= 3
        ext = os.path.splitext(urlparse(url).path.lower())[1]
        if ext in self.allowed_exts: score += 4
        return score

    def is_blocked_url(self, url: str) -> bool:
        u = url.strip().lower()
        if u.startswith(("mailto:", "javascript:")): return True
        return any(s in u for s in self.block_url_substrings)

    def is_allowed_ext(self, url: str) -> bool:
        ext = os.path.splitext(urlparse(url).path.lower())[1]
        return ext in self.allowed_exts

    def mime_allows_download(self, url: str) -> bool:
        try:
            r = requests.head(url, timeout=5, allow_redirects=True)
        except Exception:
            return False
        ct = r.headers.get("content-type", "").split(";")[0].strip().lower()
        cd = r.headers.get("content-disposition", "").lower()
        if any(ct.startswith(p) for p in self.allowed_mime_prefixes): return True
        if "filename=" in cd: return True
        if ct.startswith("text/html"): return False
        return False

    def should_download(self, url: str, score: int) -> bool:
        if score < 3: return False
        if self.is_allowed_ext(url): return True
        return self.mime_allows_download(url)

    def log(self, msg):
        timestamp = time.strftime("%H:%M:%S")
        self.log_text.insert(tk.END, f"[{timestamp}] {msg}\\n")
        self.log_text.see(tk.END)
