{
  "manifest_version": 1,
  "source_id": "wikisource_cc_by_sa",
  "source_name": "Wikisource (free-library text corpus)",
  "source_type": "website",
  "source_family": "third_party_general",
  "owner": "Wikimedia Foundation / Wikisource contributors",
  "owner_contact": "https://en.wikisource.org/wiki/Wikisource:COPY",
  "license": "cc-by-sa-4.0",
  "license_url": "https://en.wikisource.org/wiki/Wikisource:COPY",
  "rights_basis": "open-license",
  "allowed_for_training": true,
  "allowed_for_rag": true,
  "eligibility_class": "training_and_retrieval",
  "attribution_required": true,
  "attribution_text": "Attribute Wikisource contributors when contributor-authored text is included and preserve CC BY-SA 4.0 share-alike obligations downstream.",
  "share_alike_required": true,
  "removal_required": false,
  "collection_date": "2026-04-04T00:00:00Z",
  "version": "2026-04-04",
  "status": "active",
  "review_status": "approved",
  "provenance_status": "complete",
  "seed_urls": [
    "https://en.wikisource.org/wiki/Main_Page"
  ],
  "allowed_domains": [
    "en.wikisource.org"
  ],
  "host_policy": {
    "fail_closed_on_robots": true,
    "respect_crawl_delay": true,
    "crawl_delay_seconds": 1.0,
    "requests_per_minute": 12,
    "max_parallel_requests": 1,
    "daily_url_budget": 60,
    "user_agent": "JesterCrawler/1.0 (contact: sources@jester.local)",
    "allowed_schemes": ["https"],
    "allowed_path_prefixes": ["/wiki"],
    "blocked_url_patterns": [
      "https://en\\.wikisource\\.org/wiki/(Special:|Talk:|Help:|Template:|Wikisource:|Portal:|User:|File:)",
      "https://en\\.wikisource\\.org/w/"
    ],
    "robots_override_allowlist": []
  },
  "removal_path": "https://en.wikisource.org/wiki/Wikisource:COPY",
  "quarantine_rules": {
    "on_unknown_rights": "quarantine",
    "on_missing_provenance": "quarantine",
    "on_robots_failure": "quarantine",
    "on_suspect_extraction": "quarantine"
  },
  "scope_notes": "This manifest tracks free-library text pages only. Contributor text is CC BY-SA; underlying hosted works may also be public-domain or separately licensed and require title-level provenance at export time.",
  "notes": "Added from the Creative Commons source set."
}
