{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jester.local/schemas/model_contract.schema.json",
  "title": "Jester Local Model Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "runtime_target",
    "supported_task_families",
    "supported_roles",
    "request_envelope",
    "response_envelope",
    "safety",
    "notes"
  ],
  "properties": {
    "contract_id": {
      "type": "string",
      "minLength": 3
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "runtime_target": {
      "type": "string",
      "enum": [
        "provider_neutral",
        "ollama"
      ]
    },
    "supported_task_families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "narration",
          "teaching",
          "reasoning",
          "routing"
        ]
      }
    },
    "supported_roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "narrator",
          "arbiter",
          "router"
        ]
      }
    },
    "request_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "context_fields",
        "constraint_fields"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "context_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraint_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_fields",
        "optional_fields"
      ],
      "properties": {
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "optional_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_validates_output",
        "retrieval_is_backend_supplied",
        "model_is_non_authoritative_for_state"
      ],
      "properties": {
        "backend_validates_output": {
          "type": "boolean"
        },
        "retrieval_is_backend_supplied": {
          "type": "boolean"
        },
        "model_is_non_authoritative_for_state": {
          "type": "boolean"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "properties": {
        "request_envelope": {
          "properties": {
            "required_fields": {
              "allOf": [
                {
                  "contains": {
                    "const": "task_family"
                  }
                },
                {
                  "contains": {
                    "const": "role"
                  }
                },
                {
                  "contains": {
                    "const": "instruction"
                  }
                },
                {
                  "contains": {
                    "const": "context"
                  }
                },
                {
                  "contains": {
                    "const": "constraints"
                  }
                }
              ]
            }
          }
        },
        "response_envelope": {
          "properties": {
            "required_fields": {
              "allOf": [
                {
                  "contains": {
                    "const": "answer"
                  }
                },
                {
                  "contains": {
                    "const": "role"
                  }
                },
                {
                  "contains": {
                    "const": "task_family"
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "supported_task_families": {
            "contains": {
              "const": "reasoning"
            }
          }
        }
      },
      "then": {
        "properties": {
          "response_envelope": {
            "anyOf": [
              {
                "properties": {
                  "required_fields": {
                    "contains": {
                      "const": "used_context_ids"
                    }
                  }
                }
              },
              {
                "properties": {
                  "optional_fields": {
                    "contains": {
                      "const": "used_context_ids"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
