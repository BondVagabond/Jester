{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jester.local/schemas/candidate_source.schema.json",
  "title": "Jester Candidate Source",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "candidate_source_id",
    "candidate_domain",
    "seed_url",
    "first_seen_at",
    "last_seen_at",
    "discovery_methods",
    "relevance_score",
    "risk_score",
    "review_status"
  ],
  "properties": {
    "manifest_version": {"type": "integer", "const": 1},
    "candidate_source_id": {"type": "string", "pattern": "^[a-z0-9_\\-:.]+$"},
    "candidate_domain": {"type": "string", "minLength": 1},
    "seed_url": {"type": "string", "format": "uri"},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "last_seen_at": {"type": "string", "format": "date-time"},
    "discovery_methods": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "enum": ["approved_outbound_link", "sitemap", "feed", "query_seed", "search_snapshot", "manual"]}
    },
    "topic_tags": {"type": "array", "items": {"type": "string"}},
    "relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
    "risk_score": {"type": "number", "minimum": 0, "maximum": 1},
    "robots_accessible": {"type": "boolean"},
    "apparent_owner": {"type": "string"},
    "apparent_license": {"type": "string"},
    "apparent_content_type": {"type": "string"},
    "discovered_from_source_id": {"type": "string"},
    "discovery_evidence": {"type": "object"},
    "review_status": {"type": "string", "enum": ["pending_review", "approved", "rejected", "quarantined"]},
    "review_notes": {"type": "string"}
  }
}
