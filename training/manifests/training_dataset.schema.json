{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jester.local/schemas/dataset_manifest.schema.json",
  "title": "Jester Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "name",
    "version",
    "task_family",
    "role",
    "record_schema",
    "source_ids",
    "policy_categories",
    "record_count",
    "created_at",
    "created_by",
    "allowed_for_training",
    "allowed_for_rag",
    "content_hash",
    "notes"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+(?:\\.[0-9]+)*$"
    },
    "task_family": {
      "type": "string",
      "enum": [
        "narration",
        "teaching",
        "reasoning",
        "routing"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "narrator",
        "arbiter",
        "router"
      ]
    },
    "split": {
      "type": "string",
      "enum": [
        "train",
        "validation",
        "test",
        "mixed"
      ],
      "default": "train"
    },
    "record_schema": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "policy_categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "train_and_rag",
          "rag_only",
          "reference_only",
          "blocked"
        ]
      }
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "allowed_for_training": {
      "type": "boolean"
    },
    "allowed_for_rag": {
      "type": "boolean"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "normalization_version": {
          "type": "string"
        },
        "validator_version": {
          "type": "string"
        },
        "parent_dataset_id": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed_for_training": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "policy_categories": {
            "contains": {
              "const": "train_and_rag"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_categories": {
            "contains": {
              "const": "blocked"
            }
          }
        }
      },
      "then": {
        "properties": {
          "allowed_for_training": {
            "const": false
          }
        }
      }
    }
  ]
}
